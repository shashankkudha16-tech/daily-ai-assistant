# Copy to .env and adjust. Never commit the real .env file.

# --- PostgreSQL ---
DB_NAME=dailyai
DB_USERNAME=dailyai
DB_PASSWORD=replace-with-a-strong-password
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
APP_TIMEZONE=Asia/Kolkata
# Leave empty for local development. When set, POST /api/admin/** needs X-Admin-Key.
ADMIN_API_KEY=
# Dedicated key for POST /api/scheduler/** (X-Scheduler-Key). Blank disables those endpoints.
# Use a long random value; do not reuse ADMIN_API_KEY.
SCHEDULER_API_KEY=
# Session/authentication (leave the bootstrap values empty unless provisioning).
SESSION_TIMEOUT=8h
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ROLE=USER
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000,http://localhost,capacitor://localhost,https://localhost
RSS_FETCH_ON_STARTUP=true

# --- Optional AI explanations (app works without these) ---
# Defaults target Groq's free tier. The app requires no provider while AI_ENABLED=false.
AI_ENABLED=false
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=30000
AI_MAX_SOURCE_TOKENS=4500
AI_MAX_COMPLETION_TOKENS=4096
AI_MAX_ATTEMPTS=2
AI_RETRY_DELAY_MS=1000
AI_FAILURE_THRESHOLD=2
AI_COOLDOWN_MS=300000
AI_MAX_CALLS_PER_DAY=100
AI_RETRY_AFTER_MINUTES=360

# --- Frontend build ---
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
